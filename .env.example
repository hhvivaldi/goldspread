# GoldSpread — Phase 1 environment template
# Copy to .env and fill. .env is gitignored.
#
# To reuse the FlokiWatch Capital Point demo account: copy the
# MT5_* lines from FlokiWatch's .env, then delete every other key
# (no GoldSpread component needs OPENAI/GEMINI/LUNA/FCS keys).

# === MT5 credentials (Capital Point demo) ===
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# === GoldSpread settings ===
GOLDSPREAD_TICK_INTERVAL_MS=200
GOLDSPREAD_DB_PATH=data/goldspread.db
GOLDSPREAD_LOG_LEVEL=INFO
GOLDSPREAD_DAILY_CSV_EXPORT=true
