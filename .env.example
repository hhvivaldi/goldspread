# GoldSpread — Phase 1 environment template
# Copy to .env and fill. .env is gitignored.
#
# To reuse the FlokiWatch Capital Point demo account: copy the
# MT5_* lines from FlokiWatch's .env, then delete every other key
# (no GoldSpread component needs OPENAI/GEMINI/LUNA/FCS keys).

# === MT5 credentials (Capital Point demo) ===
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# === Phase 1 — logger settings ===
GOLDSPREAD_TICK_INTERVAL_MS=200
GOLDSPREAD_DB_PATH=data/goldspread.db
GOLDSPREAD_LOG_LEVEL=INFO
GOLDSPREAD_DAILY_CSV_EXPORT=true

# === Phase 2 — executor (DEFAULT OFF — set ENABLED=true to arm) ===
GOLDSPREAD_EXECUTOR_ENABLED=false
GOLDSPREAD_EXECUTOR_MAGIC=77777
GOLDSPREAD_EXECUTOR_LOT=0.01
GOLDSPREAD_EXECUTOR_MAX_POSITIONS=5
GOLDSPREAD_EXECUTOR_HOLD_MAX_SECONDS=30
GOLDSPREAD_EXECUTOR_SL_PIPS=200
GOLDSPREAD_EXECUTOR_DAILY_LOSS_CAP_USD=10.0
GOLDSPREAD_EXECUTOR_DEVIATION_POINTS=20
GOLDSPREAD_EXECUTOR_ENABLED=true
GOLDSPREAD_EXECUTOR_MIN_STREAK=5